#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Generated by `udb sdk generate` from the embedded proto descriptor set. Edit the template under sdk-templates/<lang>/, not this file.
 *
 * udb — version-matched CLI launcher for the UDB Laravel SDK.
 *
 * Installing this package (`composer require fahara02/udb-laravel`) makes a
 * `udb` command available on Composer's bin path (vendor/bin/udb, or the
 * global bin when installed globally). This launcher:
 *
 *   1. Uses $UDB_BIN if it points at an executable (operator override).
 *   2. Reuses an `udb` already on PATH **iff** its `--version` matches the
 *      SDK's pinned version (0.5.6); a mismatched PATH binary is
 *      ignored so the SDK and broker stay in lockstep.
 *   3. Otherwise downloads the matching release asset for this OS/arch from
 *      github.com/fahara02/udb (tag v0.5.6) into a per-user cache
 *      dir, then execs it.
 *
 * All trailing arguments are forwarded verbatim to the real binary.
 */

const UDB_VERSION = '0.5.6';
const UDB_REPO = 'fahara02/udb';

exit(main(array_slice($argv, 1)));

/**
 * @param  list<string>  $args
 */
function main(array $args): int
{
    $bin = resolveBinary();
    if ($bin === null) {
        fwrite(STDERR, "udb: could not locate or download the udb v" . UDB_VERSION . " binary.\n");
        return 1;
    }
    return execBinary($bin, $args);
}

/** Resolve a usable udb binary, downloading the pinned release if needed. */
function resolveBinary(): ?string
{
    // 1. Explicit operator override.
    $override = getenv('UDB_BIN');
    if (is_string($override) && $override !== '' && is_executable($override)) {
        return $override;
    }

    // 2. Version-matched binary already on PATH.
    $onPath = findOnPath('udb' . (isWindows() ? '.exe' : ''));
    if ($onPath !== null && binaryVersionMatches($onPath)) {
        return $onPath;
    }

    // 3. Cached download from a previous run.
    $cached = cachedBinaryPath();
    if (is_executable($cached)) {
        return $cached;
    }

    // 4. Download the matching release asset.
    return downloadRelease($cached);
}

/** Locate an executable on PATH without spawning `which`/`where`. */
function findOnPath(string $name): ?string
{
    $path = (string) getenv('PATH');
    $sep = isWindows() ? ';' : ':';
    foreach (explode($sep, $path) as $dir) {
        if ($dir === '') {
            continue;
        }
        $candidate = rtrim($dir, '/\\') . DIRECTORY_SEPARATOR . $name;
        if (is_file($candidate) && is_executable($candidate)) {
            return $candidate;
        }
    }
    return null;
}

/** Run `<bin> --version` and check it reports the pinned UDB version. */
function binaryVersionMatches(string $bin): bool
{
    $out = @shell_exec(escapeshellarg($bin) . ' --version 2>&1');
    if (! is_string($out)) {
        return false;
    }
    return str_contains($out, UDB_VERSION);
}

/** Per-user cache path for the downloaded binary, namespaced by version. */
function cachedBinaryPath(): string
{
    $home = getenv('HOME') ?: getenv('USERPROFILE') ?: sys_get_temp_dir();
    $base = isWindows()
        ? (getenv('LOCALAPPDATA') ?: $home)
        : (getenv('XDG_CACHE_HOME') ?: ($home . '/.cache'));
    $dir = rtrim($base, '/\\') . DIRECTORY_SEPARATOR . 'udb' . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . UDB_VERSION;
    if (! is_dir($dir)) {
        @mkdir($dir, 0o755, true);
    }
    return $dir . DIRECTORY_SEPARATOR . 'udb' . (isWindows() ? '.exe' : '');
}

/** Download the per-OS/arch release asset for tag v0.5.6. */
function downloadRelease(string $dest): ?string
{
    $asset = releaseAssetName();
    if ($asset === null) {
        fwrite(STDERR, 'udb: unsupported OS/arch for prebuilt download; set $UDB_BIN to a local build.' . "\n");
        return null;
    }
    $url = sprintf(
        'https://github.com/%s/releases/download/v%s/%s',
        UDB_REPO,
        UDB_VERSION,
        $asset
    );
    fwrite(STDERR, "udb: downloading {$url}\n");

    $data = httpGet($url);
    if ($data === null) {
        fwrite(STDERR, "udb: download failed from {$url}\n");
        return null;
    }

    // Asset may be a raw binary or a tar.gz/zip; persist raw bytes when it is a
    // bare binary, else unpack a single-file archive. For simplicity we assume
    // the release publishes a bare, per-platform binary named per releaseAssetName().
    if (file_put_contents($dest, $data) === false) {
        fwrite(STDERR, "udb: could not write cached binary to {$dest}\n");
        return null;
    }
    @chmod($dest, 0o755);
    return is_executable($dest) ? $dest : null;
}

/** Map current PHP_OS/uname arch to the GitHub release asset filename. */
function releaseAssetName(): ?string
{
    $os = strtolower(PHP_OS_FAMILY);     // Windows | Darwin | Linux | BSD | Solaris | Unknown
    $machine = strtolower(php_uname('m')); // x86_64 | amd64 | arm64 | aarch64 ...

    $arch = match (true) {
        str_contains($machine, 'arm64'), str_contains($machine, 'aarch64') => 'arm64',
        str_contains($machine, '64') => 'amd64',
        default => null,
    };
    $osTag = match ($os) {
        'windows' => 'windows',
        'darwin'  => 'darwin',
        'linux'   => 'linux',
        default   => null,
    };
    if ($arch === null || $osTag === null) {
        return null;
    }

    // Canonical published scheme: udb-<os>-<arch>[-<variant>][.exe] (RAW binary,
    // no version/triple/archive). <variant> comes from $UDB_BIN_VARIANT.
    $variant = '';
    $raw = trim((string) (getenv('UDB_BIN_VARIANT') ?: ''));
    if ($raw !== '' && strtolower($raw) !== 'portable') {
        $variant = '-' . $raw;
    }
    $ext = ($osTag === 'windows') ? '.exe' : '';

    return "udb-{$osTag}-{$arch}{$variant}{$ext}";
}

/** Minimal HTTP GET that follows redirects (GitHub release assets 302). */
function httpGet(string $url): ?string
{
    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_USERAGENT => 'udb-php-launcher/' . UDB_VERSION,
            CURLOPT_FAILONERROR => true,
            CURLOPT_CONNECTTIMEOUT => 15,
            CURLOPT_TIMEOUT => 300,
        ]);
        $body = curl_exec($ch);
        $ok = $body !== false && curl_errno($ch) === 0;
        curl_close($ch);
        return $ok ? (string) $body : null;
    }

    $ctx = stream_context_create([
        'http' => ['follow_location' => 1, 'user_agent' => 'udb-php-launcher/' . UDB_VERSION, 'timeout' => 300],
        'ssl'  => ['verify_peer' => true, 'verify_peer_name' => true],
    ]);
    $body = @file_get_contents($url, false, $ctx);
    return $body === false ? null : $body;
}

/**
 * Exec the resolved binary, forwarding args + exit code. Uses pcntl_exec when
 * available (replaces the PHP process); otherwise proc_open for a faithful
 * stdio passthrough and exit-code propagation.
 *
 * @param  list<string>  $args
 */
function execBinary(string $bin, array $args): int
{
    if (function_exists('pcntl_exec') && ! isWindows()) {
        pcntl_exec($bin, $args);
        // pcntl_exec only returns on failure.
        fwrite(STDERR, "udb: failed to exec {$bin}\n");
        return 1;
    }

    $cmd = array_merge([$bin], $args);
    $proc = proc_open(
        $cmd,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes
    );
    if (! is_resource($proc)) {
        fwrite(STDERR, "udb: failed to start {$bin}\n");
        return 1;
    }
    return proc_close($proc);
}

function isWindows(): bool
{
    return PHP_OS_FAMILY === 'Windows';
}
