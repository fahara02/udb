<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by `udb sdk generate` from the embedded proto descriptor set. Edit the template under sdk-templates/<lang>/, not this file. -->
  <!-- Rendered by `udb sdk generate`; packs the version-matched `udb` CLI as a
       .NET tool. Installing it exposes the `udb` command:
         dotnet tool install -g Udb.Cli (version 0.4.15)
       The launcher (UdbCli.cs) finds an installed `udb` on PATH or downloads the
       matching v0.4.15 release binary from github.com/fahara02/udb. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Pack as a dotnet tool whose console command is `udb`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>udb</ToolCommandName>
    <PackageId>Udb.Cli</PackageId>

    <!-- Version follows the main UDB release; single source of truth is
         /versions.json (CI enforces the match). -->
    <Version>0.4.15</Version>
    <Authors>fahara02</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fahara02/udb</RepositoryUrl>
    <Description>Version-matched launcher for the UDB CLI (0.4.15).</Description>
  </PropertyGroup>
</Project>
