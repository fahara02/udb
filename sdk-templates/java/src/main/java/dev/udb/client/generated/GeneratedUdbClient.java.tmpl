    public void validateTxStatuses(Iterable<com.udb.entity.v1.TxStatus> statuses) {
      for (com.udb.entity.v1.TxStatus status : statuses) {
        if (status.getState() != com.udb.entity.v1.TxStatus.State.TX_STATE_ERROR) {
          continue;
        }
        String message = status.getMessage().isBlank()
            ? "udb: unit-of-work transaction failed"
            : status.getMessage();
        if (isTxConflictMessage(message)) {
          throw new UnitOfWorkConflictException(message, status);
        }
        throw new UnitOfWorkTxException(message, status);
