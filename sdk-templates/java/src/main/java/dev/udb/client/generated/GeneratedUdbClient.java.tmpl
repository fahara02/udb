      List<com.udb.entity.v1.Mutation> out = new ArrayList<>();
      for (UnitOfWorkEntry entry : dirtyEntries()) {
        out.add(
            com.udb.entity.v1.Mutation.newBuilder()
                .setOperation("upsert")
                .setMessageType(entry.repository().binding().messageType())
                .setRecordJson(ByteString.copyFromUtf8(stableRecordJson(entry.record())))
                .build());
