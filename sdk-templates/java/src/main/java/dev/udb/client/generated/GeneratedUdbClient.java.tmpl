      StreamObserver<com.udb.entity.v1.Mutation> requestObserver = client.BeginTx(responseObserver);
      try {
        for (com.udb.entity.v1.Mutation mutation : txCommitBatch(backend)) {
          requestObserver.onNext(mutation);
        }
        requestObserver.onCompleted();
        done.await();
      } catch (InterruptedException err) {
        Thread.currentThread().interrupt();
        throw new IllegalStateException("udb: interrupted while flushing UnitOfWork", err);
      } catch (RuntimeException err) {
        requestObserver.onError(err);
        throw err;
      }
      Throwable err = failure.get();
      if (err != null) {
        if (err instanceof RuntimeException runtime) {
          throw runtime;
        }
        throw new IllegalStateException("udb: UnitOfWork BeginTx failed", err);
      }
      validateTxStatuses(statuses);
      markClean();
      return List.copyOf(statuses);
    }

    public void markClean() {
      for (UnitOfWorkEntry entry : entries.values()) {
        entry.snapshot = stableRecordJson(entry.record());
      }
    }

    private static void requireVersionForTrackedWrite(EntityBinding binding, Map<String, Object> record) {
      if (!binding.versionField().isBlank() && !record.containsKey(binding.versionField())) {
        throw new IllegalArgumentException(
            "udb: unit-of-work record for "
                + binding.messageType()
                + " missing version field "
                + binding.versionField());
      }
    }

    private static String entityIdentity(EntityBinding binding, Map<String, Object> record) {
      List<String> scopeParts = new ArrayList<>();
      for (String field : List.of(binding.tenantField(), binding.projectField())) {
        if (field.isBlank()) {
          continue;
        }
        if (!record.containsKey(field)) {
          throw new IllegalArgumentException(
              "udb: unit-of-work record for "
                  + binding.messageType()
                  + " missing scope field "
                  + field);
        }
        scopeParts.add(field + "=" + jsonValue(record.get(field)));
      }
      List<String> parts = new ArrayList<>();
      for (String field : binding.primaryKeys()) {
        if (!record.containsKey(field)) {
          throw new IllegalArgumentException(
              "udb: unit-of-work record for "
                  + binding.messageType()
                  + " missing primary key field "
                  + field);
        }
        parts.add(jsonValue(record.get(field)));
      }
      return binding.messageType() + ":" + String.join(":", scopeParts) + ":" + String.join(":", parts);
    }

    private static String stableRecordJson(Map<String, Object> record) {
      return jsonValue(new TreeMap<>(record));
    }

    private static String jsonValue(Object value) {
      StringBuilder sb = new StringBuilder();
      Ir.json(sb, value);
      return sb.toString();
    }

    private static boolean isTxConflictMessage(String message) {
      String lower = message.toLowerCase(java.util.Locale.ROOT);
      return lower.contains("aborted") || lower.contains("version") || lower.contains("conflict");
    }
  }
}
