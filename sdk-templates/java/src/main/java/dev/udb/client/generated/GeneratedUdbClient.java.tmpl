  /** Shared predicate accumulator for the read/delete builders. Each predicate is
   *  pre-rendered to its canonical JSON fragment so chain order is preserved. */
  abstract static class PredicateSet {
    final List<String> predicates = new ArrayList<>();

    final void addWhere(String field, String op, Object value) {
      if ("in".equals(op)) {
        if (value instanceof Iterable<?> it) {
          addWhereIn(field, it);
        } else {
          addWhereIn(field, java.util.Collections.singletonList(value));
        }
        return;
      }
      String token = Ir.COMPARISON_TOKENS.get(op);
      if (token == null) {
        throw new IllegalArgumentException("udb: unsupported IR operator '" + op + "'");
      }
      StringBuilder f = new StringBuilder("{\"Comparison\":{\"field\":");
      Ir.string(f, field);
      f.append(",\"op\":");
      Ir.string(f, token);
      f.append(",\"value\":");
      Ir.writeLogicalValue(f, value);
      f.append("}}");
      predicates.add(f.toString());
    }

    final void addWhereIn(String field, Iterable<?> values) {
      StringBuilder f = new StringBuilder("{\"InList\":{\"field\":");
      Ir.string(f, field);
      f.append(",\"values\":[");
      boolean first = true;
      for (Object v : values) {
        if (!first) {
          f.append(',');
        }
        first = false;
        Ir.writeLogicalValue(f, v);
      }
      f.append("]}}");
      predicates.add(f.toString());
    }

    final void addFilterFragment(String filter) {
      predicates.add(filter);
    }

    /** A single predicate is emitted bare; multiple are conjoined into {@code And}
     *  (mirrors {@code LogicalFilter::and}). Returns {@code null} when none is set. */
    final String filterFragment() {
      if (predicates.isEmpty()) {
        return null;
      }
      if (predicates.size() == 1) {
        return predicates.get(0);
      }
      StringBuilder f = new StringBuilder("{\"And\":[");
      for (int i = 0; i < predicates.size(); i++) {
        if (i > 0) {
          f.append(',');
        }
        f.append(predicates.get(i));
      }
      f.append("]}");
      return f.toString();
    }
  }

