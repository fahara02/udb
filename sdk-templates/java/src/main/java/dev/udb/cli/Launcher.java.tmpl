// {{GENERATED_NOTE}}
//
// UDB CLI launcher ({{LANG}}) — pinned to udb v{{UDB_VERSION}}.
//
// "Installing the SDK gives you the udb CLI." This launcher is wired as the
// executable main class via the maven-assembly / appassembler config the
// generator adds to sdk/java/pom.xml. It:
//   1. honours $UDB_BIN if it points at an executable;
//   2. else uses an already-installed `udb` on $PATH IF its `--version` matches
//      v{{UDB_VERSION}} (so the CLI stays version-matched to this SDK); every
//      PATH match is tried, launcher wrapper scripts are skipped, each probe
//      has a 5 s timeout, and a launcher started by another launcher
//      (UDB_LAUNCHER_ACTIVE set) skips PATH entirely so it cannot recurse;
//   3. else downloads the matching release asset from
//      github.com/fahara02/udb (tag v{{UDB_VERSION}}) into a per-user cache dir
//      and execs it.
//
// All trailing args are forwarded verbatim, e.g.:
//   java -jar udb-java-client-cli.jar sdk generate --help
package dev.udb.cli;

import java.io.IOException;
import java.io.InputStream;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.nio.file.attribute.PosixFilePermission;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Locale;
import java.util.Set;
import java.util.concurrent.TimeUnit;

/** Locates (or downloads) the version-matched udb binary and execs it. */
public final class Launcher {
  /** SDK-pinned udb version; the CLI is fetched/validated against this tag. */
  public static final String UDB_VERSION = "{{UDB_VERSION}}";

  private static final String REPO = "fahara02/udb";

  private Launcher() {}

  public static void main(String[] args) throws Exception {
    Path bin = resolveBinary();
    System.exit(exec(bin, args));
  }

  /** Resolve the udb binary path, downloading the pinned release if necessary. */
  public static Path resolveBinary() throws IOException, InterruptedException {
    String override = System.getenv("UDB_BIN");
    if (override != null && !override.isBlank()) {
      Path p = Path.of(override);
      if (Files.isExecutable(p)) {
        return p;
      }
    }

    // A nested launcher (one started by another launcher) never probes PATH:
    // that bounds the recursion.
    if (!isNestedLauncher()) {
      for (Path candidate : pathCandidates()) {
        if (isLauncherCandidate(candidate)) {
          continue;
        }
        if (versionMatches(candidate)) {
          return candidate;
        }
      }
    }

    Path cached = cachedBinaryPath();
    if (Files.isExecutable(cached)) {
      return cached;
    }
    return download(cached);
  }

  private static boolean isWindows() {
    return System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win");
  }

  private static String exeName() {
    return isWindows() ? "udb.exe" : "udb";
  }

  // Recursion guard. Every child this launcher starts (a `--version` probe or the
  // final exec) gets UDB_LAUNCHER_ACTIVE=1. A launcher that starts with it already
  // set is nested (a PATH candidate was itself a launcher) and never probes PATH,
  // so one invocation can start only a bounded number of processes.
  static final String LAUNCHER_ENV = "UDB_LAUNCHER_ACTIVE";
  private static final long PROBE_TIMEOUT_SECONDS = 5;
  // A launcher script (appassembler / wrapper) is small; the real binary is tens of MB.
  private static final long SHIM_SNIFF_MAX_BYTES = 2L * 1024 * 1024;

  private static boolean isNestedLauncher() {
    String v = System.getenv(LAUNCHER_ENV);
    return v != null && !v.isEmpty();
  }

  /** Every `udb` on $PATH, in PATH order (all matches, not only the first). */
  private static List<Path> pathCandidates() {
    List<Path> found = new ArrayList<>();
    String path = System.getenv("PATH");
    if (path == null) {
      return found;
    }
    Set<Path> seen = new HashSet<>();
    for (String dir : path.split(java.io.File.pathSeparator)) {
      if (dir.isBlank()) {
        continue;
      }
      Path candidate;
      try {
        candidate = Path.of(dir.trim(), exeName());
      } catch (java.nio.file.InvalidPathException e) {
        continue;
      }
      if (!Files.isExecutable(candidate) || Files.isDirectory(candidate)) {
        continue;
      }
      Path key = canonical(candidate);
      if (key == null || !seen.add(key)) {
        continue;
      }
      found.add(candidate);
    }
    return found;
  }

  private static Path canonical(Path p) {
    try {
      return p.toRealPath();
    } catch (IOException | SecurityException e) {
      return null;
    }
  }

  /**
   * True when probing {@code candidate} would run a udb launcher again: a small
   * script (the appassembler {@code bin/udb} wrapper or a copy) that names this
   * launcher's main class or the guard variable.
   */
  static boolean isLauncherCandidate(Path candidate) {
    Path real = canonical(candidate);
    if (real == null) {
      return true;
    }
    try {
      long size = Files.size(real);
      if (size <= SHIM_SNIFF_MAX_BYTES) {
        String text = new String(Files.readAllBytes(real), java.nio.charset.StandardCharsets.ISO_8859_1);
        if (text.contains(LAUNCHER_ENV) || text.contains("dev.udb.cli.Launcher")) {
          return true;
        }
      }
    } catch (IOException | SecurityException e) {
      return true;
    }
    return false;
  }

  private static boolean versionMatches(Path bin) {
    Process p = null;
    try {
      ProcessBuilder pb = new ProcessBuilder(bin.toString(), "--version").redirectErrorStream(true);
      pb.environment().put(LAUNCHER_ENV, "1");
      pb.redirectInput(ProcessBuilder.Redirect.from(nullDevice()));
      p = pb.start();
      if (!p.waitFor(PROBE_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
        p.descendants().forEach(ProcessHandle::destroyForcibly);
        p.destroyForcibly();
        return false;
      }
      // `--version` output is a single short line; it fits the pipe buffer, so
      // reading after exit cannot deadlock.
      String out = new String(p.getInputStream().readAllBytes()).trim();
      // `udb --version` prints e.g. "udb 0.6.17"; accept any line containing the tag.
      return out.contains(UDB_VERSION);
    } catch (IOException | InterruptedException e) {
      if (e instanceof InterruptedException) {
        Thread.currentThread().interrupt();
      }
      if (p != null) {
        p.destroyForcibly();
      }
      return false;
    }
  }

  private static java.io.File nullDevice() {
    return new java.io.File(isWindows() ? "NUL" : "/dev/null");
  }

  /** Per-user cache path for the pinned binary. */
  private static Path cachedBinaryPath() {
    Path base;
    if (isWindows()) {
      String localAppData = System.getenv("LOCALAPPDATA");
      base = Path.of(localAppData != null ? localAppData : System.getProperty("user.home"));
    } else {
      String xdg = System.getenv("XDG_CACHE_HOME");
      base =
          xdg != null && !xdg.isBlank()
              ? Path.of(xdg)
              : Path.of(System.getProperty("user.home"), ".cache");
    }
    return base.resolve("udb").resolve("v" + UDB_VERSION).resolve(exeName());
  }

  /**
   * The per-OS/arch release asset name, matching the canonical scheme published
   * by {@code .github/workflows/release-binaries.yml}, which attaches RAW
   * executables to the {@code v<version>} GitHub release:
   *
   * <pre>udb-&lt;os&gt;-&lt;arch&gt;[-&lt;variant&gt;]&lt;ext&gt;</pre>
   *
   * where {@code <os>} is {@code linux|darwin|windows}, {@code <arch>} is
   * {@code amd64|arm64}, the optional {@code <variant>} comes from the
   * {@code UDB_BIN_VARIANT} env var (omitted when unset/empty/"portable"), and
   * {@code <ext>} is {@code .exe} on Windows else empty. There is NO version,
   * NO Rust target triple, and NO archive suffix in the name.
   *
   * <p>Examples: {@code udb-linux-amd64}, {@code udb-windows-amd64.exe},
   * {@code udb-darwin-arm64}, {@code udb-linux-amd64-full}.
   */
  static String assetName() {
    String osProp = System.getProperty("os.name", "").toLowerCase(Locale.ROOT);
    String archProp = System.getProperty("os.arch", "").toLowerCase(Locale.ROOT);

    String os;
    if (osProp.contains("win")) {
      os = "windows";
    } else if (osProp.contains("mac") || osProp.contains("darwin")) {
      os = "darwin";
    } else {
      os = "linux";
    }

    String arch =
        (archProp.contains("aarch64") || archProp.contains("arm64")) ? "arm64" : "amd64";

    String variant = "";
    String variantEnv = System.getenv("UDB_BIN_VARIANT");
    if (variantEnv != null && !variantEnv.isBlank() && !variantEnv.equals("portable")) {
      variant = "-" + variantEnv;
    }

    String ext = "windows".equals(os) ? ".exe" : "";
    return "udb-" + os + "-" + arch + variant + ext;
  }

  private static Path download(Path dest) throws IOException, InterruptedException {
    String url =
        "https://github.com/" + REPO + "/releases/download/v" + UDB_VERSION + "/" + assetName();
    Files.createDirectories(dest.getParent());

    HttpClient http =
        HttpClient.newBuilder().followRedirects(HttpClient.Redirect.NORMAL).build();
    HttpRequest req = HttpRequest.newBuilder(URI.create(url)).GET().build();
    HttpResponse<InputStream> resp = http.send(req, HttpResponse.BodyHandlers.ofInputStream());
    if (resp.statusCode() != 200) {
      throw new IOException(
          "udb: failed to download CLI from " + url + " (HTTP " + resp.statusCode() + ")");
    }

    Path tmp = Files.createTempFile(dest.getParent(), "udb-", ".part");
    try (InputStream in = resp.body()) {
      Files.copy(in, tmp, StandardCopyOption.REPLACE_EXISTING);
    }
    verifyChecksum(http, url, tmp);
    if (!isWindows()) {
      Set<PosixFilePermission> perms =
          Set.of(
              PosixFilePermission.OWNER_READ,
              PosixFilePermission.OWNER_WRITE,
              PosixFilePermission.OWNER_EXECUTE,
              PosixFilePermission.GROUP_READ,
              PosixFilePermission.GROUP_EXECUTE,
              PosixFilePermission.OTHERS_READ,
              PosixFilePermission.OTHERS_EXECUTE);
      try {
        Files.setPosixFilePermissions(tmp, perms);
      } catch (UnsupportedOperationException ignored) {
        // Non-POSIX filesystem; nothing to do.
      }
    }
    Files.move(tmp, dest, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
    return dest;
  }

  /**
   * Best-effort SHA-256 verification of the downloaded binary against the
   * published {@code <asset>.sha256} sidecar. The sidecar holds the hex digest
   * (optionally followed by whitespace + filename, GNU coreutils style). A
   * missing/unreachable sidecar is non-fatal; a present-but-mismatched digest
   * aborts the install.
   */
  private static void verifyChecksum(HttpClient http, String assetUrl, Path file)
      throws IOException, InterruptedException {
    String expected;
    try {
      HttpRequest req = HttpRequest.newBuilder(URI.create(assetUrl + ".sha256")).GET().build();
      HttpResponse<String> resp = http.send(req, HttpResponse.BodyHandlers.ofString());
      if (resp.statusCode() != 200) {
        return; // No sidecar published; skip verification.
      }
      String body = resp.body().trim();
      if (body.isEmpty()) {
        return;
      }
      expected = body.split("\\s+", 2)[0].toLowerCase(Locale.ROOT);
    } catch (IOException e) {
      return; // Sidecar unreachable; non-fatal.
    }

    String actual;
    try {
      java.security.MessageDigest md = java.security.MessageDigest.getInstance("SHA-256");
      byte[] digest = md.digest(Files.readAllBytes(file));
      StringBuilder sb = new StringBuilder(digest.length * 2);
      for (byte b : digest) {
        sb.append(Character.forDigit((b >> 4) & 0xF, 16));
        sb.append(Character.forDigit(b & 0xF, 16));
      }
      actual = sb.toString();
    } catch (java.security.NoSuchAlgorithmException e) {
      return; // SHA-256 unavailable on this JRE (unexpected); skip rather than fail.
    }

    if (!actual.equals(expected)) {
      Files.deleteIfExists(file);
      throw new IOException(
          "udb: checksum mismatch for "
              + assetUrl
              + " (expected "
              + expected
              + ", got "
              + actual
              + ")");
    }
  }

  private static int exec(Path bin, String[] args) throws IOException, InterruptedException {
    String[] cmd = new String[args.length + 1];
    cmd[0] = bin.toString();
    System.arraycopy(args, 0, cmd, 1, args.length);
    ProcessBuilder pb = new ProcessBuilder(cmd).inheritIO();
    pb.environment().put(LAUNCHER_ENV, "1");
    Process p = pb.start();
    return p.waitFor();
  }
}
