    // @@UDB_SERVICE_BEGIN
    /**
     * Underlying buf-generated stub for {{SERVICE_FULL}} ({{SERVICE_RPC_COUNT}} RPC(s)).
     * Channel is shared with every other service stub on this client.
     *
     * @return BaseStub  a {{SERVICE_NAME}}Client
