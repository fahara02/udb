            '{{RPC_WIRE_NAME}}',
            '{{SERVICE_NAME}}',
            '{{SERVICE_PKG}}',
            fn (BaseStub $stub, array $md, array $opts) => $stub->{{RPC_WIRE_NAME}}($request, $md, $opts),
            $metadata,
            '{{RPC_OPERATION_KIND}}' === 'read_only',
            $request,
