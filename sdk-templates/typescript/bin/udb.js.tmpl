#!/usr/bin/env node
// {{GENERATED_NOTE}}
//
// Version-matched `udb` CLI launcher bundled with @udb_plus/sdk v{{UDB_VERSION}}.
//
// Resolution order:
//   1. $UDB_BIN, if set and executable, is used verbatim.
//   2. A `udb` already on PATH whose `--version` matches v{{UDB_VERSION}} is used.
//      Every PATH match is tried in order; this launcher, its npm shims and any
//      other launcher copy are skipped, each probe has a 5 s timeout, and a
//      launcher started by another launcher (UDB_LAUNCHER_ACTIVE set) skips
//      PATH entirely, so a launcher can never recurse into itself.
//   3. Otherwise the matching raw release binary is downloaded once from
//      github.com/fahara02/udb (tag v{{UDB_VERSION}}, asset `udb-<os>-<arch>[-<variant>][.exe]`)
//      into a per-user cache dir and executed thereafter.
//
// The downloaded binary is cached at:
//   $UDB_CACHE_DIR || <os-cache>/udb/v{{UDB_VERSION}}/udb[.exe]
"use strict";

const { spawnSync, execFileSync } = require("child_process");
const fs = require("fs");
const os = require("os");
const path = require("path");
const https = require("https");
const crypto = require("crypto");

const UDB_VERSION = "{{UDB_VERSION}}";
const REPO = "fahara02/udb";

function logErr(msg) {
  process.stderr.write(`udb-launcher: ${msg}\n`);
}

// ── Per-OS / arch release asset name ────────────────────────────────────────────
// Canonical published scheme (see .github/workflows/release-binaries.yml — RAW
// executables attached to the GitHub release tag v<version>):
//   udb-<os>-<arch>[-<variant>][.exe]
//   <os>:      linux | darwin | windows
//   <arch>:    amd64 | arm64
//   <variant>: $UDB_BIN_VARIANT, omitted when unset/empty/"portable"
//   <ext>:     ".exe" on win32, else none
// No version in the name, no .tar.gz/.zip — the asset is a raw binary.
// Examples: udb-linux-amd64 ; udb-windows-amd64.exe ; udb-darwin-arm64 ; udb-linux-amd64-full
function assetName() {
  const osMap = { linux: "linux", darwin: "darwin", win32: "windows" };
  const archMap = { x64: "amd64", arm64: "arm64" };
  const o = osMap[process.platform];
  if (!o) throw new Error(`unsupported platform: ${process.platform}`);
  const a = archMap[process.arch];
  if (!a) throw new Error(`unsupported arch: ${process.arch}`);

  const variant = (process.env.UDB_BIN_VARIANT || "").trim();
  const variantSuffix = variant && variant !== "portable" ? `-${variant}` : "";
  const ext = process.platform === "win32" ? ".exe" : "";
  return `udb-${o}-${a}${variantSuffix}${ext}`;
}

function binName() {
  return process.platform === "win32" ? "udb.exe" : "udb";
}

function cacheDir() {
  if (process.env.UDB_CACHE_DIR) return process.env.UDB_CACHE_DIR;
  const base =
    process.platform === "win32"
      ? process.env.LOCALAPPDATA || path.join(os.homedir(), "AppData", "Local")
      : process.platform === "darwin"
        ? path.join(os.homedir(), "Library", "Caches")
        : process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache");
  return path.join(base, "udb", `v${UDB_VERSION}`);
}

// ── Recursion guard ─────────────────────────────────────────────────────────────
// Every child this launcher starts (a `--version` probe or the final exec) gets
// UDB_LAUNCHER_ACTIVE=1. A launcher that starts with it already set is nested
// (some PATH candidate was itself a launcher) and must never probe PATH, so one
// invocation can start at most a bounded number of processes.
const LAUNCHER_ENV = "UDB_LAUNCHER_ACTIVE";
const PROBE_TIMEOUT_MS = 5000;
// A launcher script or shim is small; the real udb binary is tens of MB.
const SHIM_SNIFF_MAX_BYTES = 2 * 1024 * 1024;

function childEnv() {
  return { ...process.env, [LAUNCHER_ENV]: "1" };
}

function isNestedLauncher() {
  return Boolean(process.env[LAUNCHER_ENV]);
}

// ── Reuse an existing version-matched binary ────────────────────────────────────
function versionMatches(bin) {
  try {
    const out = execFileSync(bin, ["--version"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
      env: childEnv(),
      timeout: PROBE_TIMEOUT_MS,
      killSignal: "SIGKILL",
      windowsHide: true,
    });
    return out.includes(UDB_VERSION);
  } catch {
    return false;
  }
}

function realpathOrNull(p) {
  try {
    return fs.realpathSync(p);
  } catch {
    return null;
  }
}

function samePath(a, b) {
  if (!a || !b) return false;
  return process.platform === "win32" ? a.toLowerCase() === b.toLowerCase() : a === b;
}

// True when `candidate` is this launcher (or a shim/copy of a udb launcher) and
// so must never be probed: probing it would run a launcher again.
function isLauncherCandidate(candidate) {
  const real = realpathOrNull(candidate);
  if (!real) return true;
  const selves = [__filename, process.argv[1]].filter(Boolean).map(realpathOrNull);
  if (selves.some((s) => samePath(real, s))) return true;
  // npm / yarn / pnpm bin shims live in node_modules/.bin and point at a launcher.
  const parts = path.resolve(candidate).split(/[\\/]+/);
  for (let i = 0; i + 1 < parts.length; i += 1) {
    if (parts[i] === "node_modules" && parts[i + 1] === ".bin") return true;
  }
  // Windows only executes a real `udb.exe` here; `udb`, `udb.cmd`, `udb.ps1` are shims.
  if (process.platform === "win32" && !real.toLowerCase().endsWith(".exe")) return true;
  // A small file naming the guard variable is a launcher copy (this file, another
  // project's copy, or a wrapper around one).
  try {
    const st = fs.statSync(real);
    if (!st.isFile()) return true;
    if (st.size <= SHIM_SNIFF_MAX_BYTES && fs.readFileSync(real).includes(LAUNCHER_ENV)) return true;
  } catch {
    return true;
  }
  return false;
}

// Every `udb` on PATH, in PATH order (all matches, not just the first).
function pathCandidates() {
  const which = process.platform === "win32" ? "where" : "which";
  const args = process.platform === "win32" ? ["udb"] : ["-a", "udb"];
  const r = spawnSync(which, args, {
    encoding: "utf8",
    env: childEnv(),
    timeout: PROBE_TIMEOUT_MS,
    windowsHide: true,
  });
  if (r.status !== 0 || typeof r.stdout !== "string") return [];
  const seen = new Set();
  const out = [];
  for (const line of r.stdout.split(/\r?\n/)) {
    const c = line.trim();
    if (!c || seen.has(c)) continue;
    seen.add(c);
    out.push(c);
  }
  return out;
}

function findOnPath() {
  if (process.env.UDB_BIN && fs.existsSync(process.env.UDB_BIN)) return process.env.UDB_BIN;
  // A nested launcher never probes PATH: that is what bounds the recursion.
  if (isNestedLauncher()) return null;
  for (const candidate of pathCandidates()) {
    if (isLauncherCandidate(candidate)) continue;
    if (versionMatches(candidate)) return candidate;
  }
  return null;
}

// ── Download (raw binary) on cache miss ─────────────────────────────────────────
function httpsGet(url, dest) {
  return new Promise((resolve, reject) => {
    const req = https.get(url, { headers: { "User-Agent": "udb-sdk-launcher" } }, (res) => {
      if (res.statusCode && res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        res.resume();
        return httpsGet(res.headers.location, dest).then(resolve, reject);
      }
      if (res.statusCode !== 200) {
        res.resume();
        return reject(new Error(`download ${url} failed: HTTP ${res.statusCode}`));
      }
      const file = fs.createWriteStream(dest);
      res.pipe(file);
      file.on("finish", () => file.close(() => resolve()));
      file.on("error", reject);
    });
    req.on("error", reject);
  });
}

// Fetch a small text body (the `.sha256` sidecar) into memory, following
// redirects. Resolves null on any non-200 so checksum verification stays
// best-effort and non-fatal when the sidecar is absent.
function httpsGetText(url) {
  return new Promise((resolve) => {
    const req = https.get(url, { headers: { "User-Agent": "udb-sdk-launcher" } }, (res) => {
      if (res.statusCode && res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        res.resume();
        return httpsGetText(res.headers.location).then(resolve);
      }
      if (res.statusCode !== 200) {
        res.resume();
        return resolve(null);
      }
      const chunks = [];
      res.on("data", (c) => chunks.push(c));
      res.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
      res.on("error", () => resolve(null));
    });
    req.on("error", () => resolve(null));
  });
}

function sha256File(file) {
  const hash = crypto.createHash("sha256");
  hash.update(fs.readFileSync(file));
  return hash.digest("hex");
}

// Best-effort checksum check against `<asset>.sha256`. Non-fatal if the sidecar
// is missing/unreadable; throws only on an actual hash mismatch.
async function verifyChecksum(file, asset) {
  const sidecarUrl = `https://github.com/${REPO}/releases/download/v${UDB_VERSION}/${asset}.sha256`;
  const body = await httpsGetText(sidecarUrl);
  if (!body) {
    logErr(`checksum sidecar ${asset}.sha256 unavailable — skipping verification`);
    return;
  }
  // Accept either a bare hash or the `<hash>  <filename>` (sha256sum) layout.
  const expected = (body.trim().split(/\s+/)[0] || "").toLowerCase();
  if (!/^[0-9a-f]{64}$/.test(expected)) {
    logErr(`checksum sidecar ${asset}.sha256 malformed — skipping verification`);
    return;
  }
  const actual = sha256File(file).toLowerCase();
  if (actual !== expected) {
    throw new Error(`checksum mismatch for ${asset}: expected ${expected}, got ${actual}`);
  }
}

async function ensureBinary() {
  const dir = cacheDir();
  const cached = path.join(dir, binName());
  if (fs.existsSync(cached) && versionMatches(cached)) return cached;

  if (process.env.UDB_NO_DOWNLOAD || process.env.UDB_SKIP_DOWNLOAD) {
    throw new Error(`udb v${UDB_VERSION} not cached and downloads are disabled (UDB_NO_DOWNLOAD)`);
  }

  fs.mkdirSync(dir, { recursive: true });
  const asset = assetName();
  const url = `https://github.com/${REPO}/releases/download/v${UDB_VERSION}/${asset}`;
  // The published asset is a RAW executable — download bytes straight to a temp
  // path, verify, then atomically rename into place. No archive extraction.
  const tmp = path.join(dir, `${binName()}.download`);
  logErr(`downloading ${asset} (udb v${UDB_VERSION}) …`);
  await httpsGet(url, tmp);
  try {
    await verifyChecksum(tmp, asset);
  } catch (e) {
    try {
      fs.unlinkSync(tmp);
    } catch {
      /* best-effort cleanup */
    }
    throw e;
  }
  if (process.platform !== "win32") fs.chmodSync(tmp, 0o755);
  fs.renameSync(tmp, cached);
  return cached;
}

async function main() {
  let bin = findOnPath();
  if (!bin) {
    try {
      bin = await ensureBinary();
    } catch (e) {
      logErr(`could not obtain udb v${UDB_VERSION}: ${e.message}`);
      logErr(`set $UDB_BIN to an installed binary, or install udb manually:`);
      logErr(`  https://github.com/${REPO}/releases/tag/v${UDB_VERSION}`);
      process.exit(127);
    }
  }
  const child = spawnSync(bin, process.argv.slice(2), { stdio: "inherit", env: childEnv() });
  if (child.error) {
    logErr(`failed to exec ${bin}: ${child.error.message}`);
    process.exit(126);
  }
  process.exit(child.status == null ? 1 : child.status);
}

main();
