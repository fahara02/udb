# ── Example app build artifacts / vendored deps (source only) ────────────────
# The example projects are checked in as source; their installed dependencies
# and compiled output are not. `examples/native-services/` ships no own ignore.
examples/**/node_modules/
examples/**/__pycache__/
examples/**/*.pyc
examples/**/vendor/
examples/**/dist/
examples/**/build/
examples/**/bin/
examples/**/obj/
examples/native-services/go/go.exe

# ── Spark Structured Streaming runtime output (checkpoints / parquet) ────────
# `analytics/spark/auth_events_streaming.py` writes windowed metrics + the
# streaming checkpoint under these dirs; they are regenerated on every run and
# must never be committed.
analytics/spark/_out/
analytics/spark/_spark_out/
analytics/spark/**/_chk/

# ── Benchmark dataset & profiles (D.2) ───────────────────────────────────────
# `data/gen_bench_data.py` generates up to ~1 GiB of NDJSON for the hot-path
# benches; the data is regenerable and must never be committed. Keep the
# generator script (and an optional README) tracked.
/data/*
!/data/gen_bench_data.py
!/data/README.md
# dhat heap-profile output from `examples/dhat_hotpath`.
dhat-heap.json
dhat-heap.json.*
# Vibrant chart artifacts rendered by scripts/bench_charts.py (regenerable).
/bench-artifacts/
/bench-history/
# Python bytecode cache (e.g. scripts/__pycache__).
__pycache__/
*.pyc
# Raw bench stdout captures (transient).
/live_bench_raw.txt
/hp2.txt
# Criterion saved baselines/reports live under target/ (already ignored).

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Private plans (local only) ───────────────────────────────────────────────
/private/

# ── Claude AI ────────────────────────────────────────────────────────────────
/.claude/
/.claude-plugin/
/.claude_plugin/

# Brand images are synced into the published site from docs/assets by CI;
# the canonical source stays in docs/assets (not duplicated in git).
/docs/site/assets/

# Swagger JSON is synced into the published site from api/ by CI;
# the canonical source stays in api/ (not duplicated in git).
/docs/site/api/

# Local bench harness: the .ps1 launchers/grind scripts ARE versioned; only the
# runtime artifacts are ignored (logs already covered by *.log above).
.bench-local/*.pid
.bench-local/audit.jsonl
.bench-local/ffmpeg-transcode-smoke/
.bench-local/idempotency-smoke/

# HL7v2 parser websuite downloads are regenerated from the tracked manifest.
/tests/fixtures/hl7v2/websuite/generated/
/tests/fixtures/hl7v2/websuite/report.json

# Local ffmpeg binary cache; GitHub rejects this Windows executable (>100 MB).
/third_party/ffmpeg/bin/windows/ffmpeg.exe
/.cache/
.continue/*
.serena
bug_reports