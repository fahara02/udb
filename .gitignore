sdk/python/**/__pycache__/
sdk/python/**/*.pyc
sdk/python/**/*.pyo
sdk/python/**/*.pyd
sdk/python/**/.venv/
sdk/python/**/venv/
sdk/python/**/.pytest_cache/
sdk/python/**/*.egg-info/
sdk/python/**/dist/
sdk/python/**/build/
sdk/python/**/.mypy_cache/
sdk/python/**/.ruff_cache/

# ── Go SDK ───────────────────────────────────────────────────────────────────
sdk/go/**/vendor/
sdk/go/**/*.test
sdk/go/**/*.out
sdk/go/coverage.out

