sdk/php/.phpunit.result.cache
sdk/php/.php-cs-fixer.cache
sdk/php/.phpstan-cache/
sdk/php/coverage/
sdk/php/build/

# ── Generated SDK stubs ──────────────────────────────────────────────────────
# Generated stubs for SDKs that ship as their own package (PHP,
# Python, TypeScript) ARE committed so `composer require`, `pip install`,
# and `npm install` work without buf/protoc installed on the consumer side.
# Go / C# regenerate through their respective package-manager workflows.
sdk/csharp/Generated/

# ── Docs ─────────────────────────────────────────────────────────────────────
docs/generated/
docs/upgrade_todo.md

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
configs/*.yaml
!configs/*.example.yaml
!configs/database.yaml
!configs/backends.yaml
!configs/services.yaml
!configs/ci.yaml
!configs/redis.yaml
*.pem
*.key
*.crt
udb_laravel_deploy_key
udb_laravel_deploy_key.pub

# ── Docker ───────────────────────────────────────────────────────────────────
.docker/

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Example app build artifacts / vendored deps (source only) ────────────────
# The example projects are checked in as source; their installed dependencies
# and compiled output are not. `examples/native-services/` ships no own ignore.
examples/**/node_modules/
examples/**/__pycache__/
examples/**/*.pyc
examples/**/vendor/
examples/**/dist/
examples/**/build/
examples/**/bin/
examples/**/obj/
examples/native-services/go/go.exe

# ── Spark Structured Streaming runtime output (checkpoints / parquet) ────────
# `analytics/spark/auth_events_streaming.py` writes windowed metrics + the
# streaming checkpoint under these dirs; they are regenerated on every run and
# must never be committed.
analytics/spark/_out/
analytics/spark/_spark_out/
analytics/spark/**/_chk/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
