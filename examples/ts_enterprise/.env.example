# Client env for the enterprise example. The real values are produced by
# ./scripts/bootstrap.sh into ./secrets/enterprise.env — source THAT instead of
# copying secrets here:
#
#   set -a; source secrets/enterprise.env; set +a
#   npm start
#
# These are the only vars src/main.ts reads (the rest of enterprise.env is for
# the broker):
UDB_TARGET=127.0.0.1:50051          # public DataBroker (data plane)
UDB_AUTH_TARGET=127.0.0.1:50061     # native auth control plane (authn/authz)
UDB_TENANT=acme                     # human tenant code (login resolves the UUID)
UDB_USER=admin
UDB_PASS=AdminPassw0rd!23           # the password you passed to bootstrap.sh
