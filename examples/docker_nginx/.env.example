# docker_nginx example — environment
#
# Run ./scripts/setup.sh instead of editing this by hand. It copies this file to
# .env and generates every secret (through deploy/scripts/init.sh, which runs
# `udb env fill` inside the broker image). A value already in .env is never
# changed.
#
# Read by docker compose for ${...} and by the broker container (env_file).
# LF line endings, KEY=value, no quotes.

# ── Image ────────────────────────────────────────────────────────────────────
UDB_IMAGE=ghcr.io/fahara02/udb
UDB_VERSION=0.6.16

# ── Postgres ─────────────────────────────────────────────────────────────────
# setup.sh replaces the placeholder (both lines) with one random value.
POSTGRES_PASSWORD=change-me-pg-password
UDB_PG_DSN=postgres://udb:change-me-pg-password@postgres:5432/udb?sslmode=disable

# ── Posture ──────────────────────────────────────────────────────────────────
# TLS is terminated by nginx; the broker is reachable only on the compose network.
UDB_ENV=development
UDB_APP_NAME=shop
RUST_LOG=info
UDB_GRPC_ADDR=0.0.0.0:50051
UDB_TLS_REQUIRED=false
UDB_MTLS_REQUIRED=false

# ── Authentication ───────────────────────────────────────────────────────────
UDB_SESSION_ENABLED=true
# Generated by setup.sh: UDB_SESSION_HASH_SECRET, UDB_API_KEY_HASH_SECRET,
# UDB_PASSWORD_HASH_SECRET, UDB_ENCRYPTION_KEY, UDB_APPROVAL_SIGNING_KEY,
# UDB_JWT_PRIVATE_KEY, UDB_JWT_PUBLIC_KEY.

# ── Behind nginx ─────────────────────────────────────────────────────────────
# nginx overwrites X-Real-IP / X-Forwarded-For with the real client address,
# so the broker may rate-limit on them. Only safe because nothing but nginx can
# reach the broker; never set this on a broker clients reach directly.
UDB_TRUST_PROXY_IP_HEADERS=true

# ── Schema / backends ────────────────────────────────────────────────────────
UDB_MIGRATE_ENABLED=true
UDB_ALLOW_DEGRADED_BACKENDS=true
UDB_CDC_JOURNAL_ONLY=true

# ── Edge ─────────────────────────────────────────────────────────────────────
# Where nginx's TLS port is published on the host. Loopback by default; set
# UDB_EDGE_BIND=0.0.0.0 to serve other machines.
UDB_EDGE_BIND=127.0.0.1
UDB_EDGE_PORT=443
